---
import { Play, Calendar, FileText, Headphones, Video } from 'lucide-astro';
import type { ArchiveRecord } from '../lib/notion';

interface Props {
  record: ArchiveRecord;
}

const { record } = Astro.props;
---

<article class="group bg-night-800/60 border border-night-700/70 rounded-xl overflow-hidden transition duration-300 hover:border-amber-candle/40 hover:bg-night-800 flex flex-col justify-between">
  <div>
    <!-- NÁHLEDOVÝ OBRÁZEK SPISU -->
    <a href={`/archiv/${record.slug}`} class="block relative aspect-video overflow-hidden bg-night-950 border-b border-night-700/60">
      {record.imageUrl ? (
        <img 
          src={record.imageUrl} 
          alt={record.title}
          class="w-full h-full object-cover group-hover:scale-105 transition duration-500 filter brightness-90 contrast-105"
          loading="lazy"
        />
      ) : (
        <!-- Záložní atmosférický vizuál, pokud obrázek chybí -->
        <div class="w-full h-full bg-gradient-to-br from-night-900 via-night-950 to-night-900 flex items-center justify-center p-6 text-center relative">
          <div class="absolute inset-0 bg-[radial-gradient(#d49a45_1px,transparent_1px)] [background-size:16px_16px] opacity-10"></div>
          <span class="font-serif italic text-parchment-400 text-sm tracking-wide line-clamp-2">
            „{record.title}“
          </span>
        </div>
      )}
      
      <!-- Odznak staletí přímo přes roh obrázku -->
      <div class="absolute top-3 left-3 flex items-center gap-1.5">
        <span class="text-[11px] font-medium px-2 py-0.5 rounded bg-night-950/80 backdrop-blur border border-amber-candle/30 text-amber-candle">
          {record.century}
        </span>
      </div>

      <!-- Indikátor formátu (video / audio / text) -->
      <div class="absolute bottom-3 right-3 flex items-center gap-1.5 bg-night-950/80 backdrop-blur px-2 py-1 rounded-md border border-night-700 text-xs">
        {record.youtubeId && <Video class="w-3.5 h-3.5 text-amber-candle" title="Obsahuje video" />}
        {record.spotifyUrl && <Headphones class="w-3.5 h-3.5 text-green-400" title="Obsahuje audio poslech" />}
        <FileText class="w-3.5 h-3.5 text-parchment-400" title="Obsahuje písemný záznam" />
      </div>
    </a>

    <!-- TEXTOVÁ ČÁST KARTY -->
    <div class="p-5">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-[11px] uppercase tracking-wider text-parchment-600 font-mono">
          {record.category}
        </span>
      </div>

      <h3 class="font-serif text-lg sm:text-xl text-parchment-200 mb-2 group-hover:text-amber-candle transition line-clamp-2 leading-snug font-medium">
        <a href={`/archiv/${record.slug}`}>
          {record.title}
        </a>
      </h3>

      <p class="text-parchment-400 text-xs sm:text-sm line-clamp-2 leading-relaxed font-light">
        {record.annotation}
      </p>
    </div>
  </div>

  <!-- SPODNÍ LIŠTA -->
  <div class="px-5 py-4 border-t border-night-700/50 flex items-center justify-between text-xs bg-night-900/30">
    <span class="text-parchment-600 flex items-center gap-1 font-mono">
      <Calendar class="w-3.5 h-3.5 text-amber-brass" />
      {record.date}
    </span>
    
    <a 
      href={`/archiv/${record.slug}`} 
      class="text-amber-candle flex items-center gap-1.5 font-medium group-hover:translate-x-1 transition duration-200"
    >
      {record.hasMedia ? 'Otevřít a pustit' : 'Číst spis'} 
      <Play class="w-3 h-3 fill-current" />
    </a>
  </div>
</article>
