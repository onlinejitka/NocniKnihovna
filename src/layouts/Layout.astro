---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { 
  title, 
  description = "Noční badatelna archivářky Jitky. Zapomenuté kroniky, smolné knihy a staré prameny bez školního patosu.",
  ogImage = "/images/og-preview.jpg"
} = Astro.props;

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="cs" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Noční Knihovna</title>
    <meta name="description" content={description} />
    
    <!-- OpenGraph & Seznam tagy -->
    <meta property="og:site_name" content="Noční Knihovna" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    
    <!-- Google Fonts: Playfair Display + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
  </head>
  <body class="bg-night-900 text-parchment-300 font-sans antialiased selection:bg-amber-candle selection:text-night-950 flex flex-col min-h-screen">
    <!-- Podkladová textura s jemným nočním kuželem světla lampy -->
    <div class="fixed inset-0 pointer-events-none bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(212,154,69,0.08),rgba(15,17,21,0))] z-0"></div>
    
    <Header />
    <main class="relative z-10 flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* Dark Academia scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #0f1115;
  }
  ::-webkit-scrollbar-thumb {
    background: #232836;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #b87333;
  }
</style>
