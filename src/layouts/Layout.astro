---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const {
  title,
  description = "Noční badatelna archivářky Jitky. Zvukové vyprávění a dobové texty otevírající skutečné lidské osudy bez školní rigidity.",
  image = "/images/badatelna-hero.jpg",
  type = "website",
  publishedTime
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://www.nocniknihovna.cz");
const socialImageURL = new URL(image, "https://www.nocniknihovna.cz");
const siteTitle = title.includes("Noční Knihovna") ? title : `${title} | Noční Knihovna`;

// Měřicí ID pro Google Analytics 4
const gaId = import.meta.env.PUBLIC_GA_ID || "G-2VFL08QREV";
---

<!doctype html>
<html lang="cs" class="scroll-smooth bg-night-950 text-parchment-200 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primární SEO tagy -->
    <title>{siteTitle}</title>
    <meta name="title" content={siteTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="Archivářka Jitka" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Noční Knihovna" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:locale" content="cs_CZ" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={siteTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <meta name="theme-color" content="#0f1115" />

    <!-- Google Fonts: Playfair Display -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">

    <!-- Google Analytics 4 -->
    {gaId && import.meta.env.PROD && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-night-950 text-parchment-300 font-sans selection:bg-amber-candle/30 selection:text-parchment-100">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
