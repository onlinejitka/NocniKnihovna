---
import Layout from '../layouts/Layout.astro';
import { getMovies } from '../lib/notion';
import { Film, Tv, Calendar, ExternalLink, Sparkles } from 'lucide-astro';

const movies = await getMovies();
const eras = Array.from(new Set(movies.map((m) => m.era).filter(Boolean)));
---

<Layout 
  title="Historická filmotéka"
  description="Výběr historických filmů a seriálů s atmosférou, dobovými detaily a pohledem archivářky."
>
  <section class="max-w-6xl mx-auto px-6 py-14 md:py-20 space-y-12">
    
    <!-- HLAVIČKA SEKCE -->
    <header class="max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 text-xs uppercase tracking-widest text-amber-candle font-medium">
        <Film class="w-4 h-4" />
        <span>Doporučení pro dlouhé večery</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl text-parchment-200 font-semibold leading-tight">
        Historická filmotéka
      </h1>
      <p class="text-parchment-400 text-base sm:text-lg font-light leading-relaxed">
        Snímky a série, které dokázaly zachytit ducha doby, lidskou mentalitu i kulisy minulosti bez zbytečného pozlátka. Výběr toho nejlepšího očima archivářky.
      </p>
    </header>

    <!-- FILTRY (VŠE / FILMY / SERIÁLY + OBDOBÍ) -->
    {movies.length > 0 && (
      <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-night-700/60">
        <div class="flex flex-wrap items-center gap-2" id="typeFilters">
          <button 
            type="button" 
            data-type="all"
            class="filter-type-btn px-4 py-2 rounded-lg text-xs font-medium bg-amber-candle text-night-950 transition"
          >
            Vše ({movies.length})
          </button>
          <button 
            type="button" 
            data-type="Film"
            class="filter-type-btn px-4 py-2 rounded-lg text-xs font-medium bg-night-900 border border-night-700 text-parchment-300 hover:border-amber-candle/40 transition"
          >
            Filmy
          </button>
          <button 
            type="button" 
            data-type="Seriál"
            class="filter-type-btn px-4 py-2 rounded-lg text-xs font-medium bg-night-900 border border-night-700 text-parchment-300 hover:border-amber-candle/40 transition"
          >
            Seriály
          </button>
        </div>

        {eras.length > 1 && (
          <select 
            id="eraSelect"
            aria-label="Filtrovat podle období"
            class="px-4 py-2 rounded-lg bg-night-900 border border-night-700 text-parchment-300 text-xs focus:outline-none focus:border-amber-candle"
          >
            <option value="all">Všechna období</option>
            {eras.map((era) => (
              <option value={era}>{era}</option>
            ))}
          </select>
        )}
      </div>
    )}

    <!-- MŘÍŽKA FILMŮ A SERIÁLŮ -->
    {movies.length === 0 ? (
      <div class="text-center py-20 border border-dashed border-night-700 rounded-2xl bg-night-800/20 space-y-3">
        <Film class="w-10 h-10 text-amber-candle/50 mx-auto" />
        <p class="font-serif text-xl text-parchment-200">Katalog promítání se právě připravuje</p>
        <p class="text-parchment-400 text-sm font-light max-w-md mx-auto">
          Brzy zde najdete první tipy na historické filmy a seriály z badatelny.
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="moviesGrid">
        {movies.map((movie) => (
          <article 
            class="movie-card group bg-night-800/60 border border-night-700/70 rounded-2xl overflow-hidden flex flex-col justify-between transition duration-300 hover:border-amber-candle/40 hover:bg-night-800"
            data-type={movie.type}
            data-era={movie.era}
          >
            <div>
              <!-- PLAKÁT NA VÝŠKU (POMĚR 2:3) -->
              <div class="relative aspect-[2/3] overflow-hidden bg-night-950 border-b border-night-700/60">
                {movie.imageUrl ? (
                  <>
                    <img 
                      src={movie.imageUrl} 
                      alt={movie.title}
                      class="w-full h-full object-cover object-top group-hover:scale-105 transition duration-500 filter brightness-95"
                      loading="lazy"
                    />
                    <!-- Jemné ztmavení okrajů pro čitelnost štítků -->
                    <div class="absolute inset-0 bg-gradient-to-t from-night-950/75 via-transparent to-night-950/35 pointer-events-none"></div>
                  </>
                ) : (
                  <div class="w-full h-full bg-gradient-to-b from-night-900 via-night-950 to-night-900 p-6 flex items-center justify-center text-center">
                    <div class="w-full h-full border border-amber-candle/20 rounded-xl flex flex-col items-center justify-center p-6 space-y-3">
                      <Film class="w-6 h-6 text-amber-brass/40" />
                      <span class="font-serif italic text-parchment-300 text-lg leading-snug">
                        {movie.title}
                      </span>
                      {movie.year && (
                        <span class="text-xs font-mono text-parchment-600">{movie.year}</span>
                      )}
                    </div>
                  </div>
                )}

                <!-- Štítek Film / Seriál -->
                <div class="absolute top-3 left-3 flex items-center gap-1.5">
                  <span class="inline-flex items-center gap-1 text-[11px] font-medium px-2.5 py-1 rounded bg-night-950/85 backdrop-blur border border-amber-candle/30 text-amber-candle shadow-sm">
                    {movie.type === 'Seriál' ? <Tv class="w-3 h-3" /> : <Film class="w-3 h-3" />}
                    {movie.type}
                  </span>
                </div>

                <!-- Historické období -->
                {movie.era && (
                  <div class="absolute bottom-3 right-3">
                    <span class="text-[11px] px
