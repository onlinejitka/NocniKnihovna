---
import Layout from '../../layouts/Layout.astro';
import RecordCard from '../../components/RecordCard.astro';
import { getArchiveRecords } from '../../lib/notion';
import { Compass, Search, Filter, BookX } from 'lucide-astro';

const records = await getArchiveRecords();

const categories = ["Vše", "Zvyky", "Kriminalita", "Magie", "Všední den"];
const centuries = ["Všechna staletí", "14. století", "15. století", "16. století", "17. století", "18. století", "Průřezové"];
---

<Layout 
  title="Archiv badatelny | Nahrávky a písemné prameny" 
  description="Kompletní fond Noční Knihovny. Audio vyprávění, dobové texty, soudní akta a rozbory historických pramenů na jednom místě."
>
  <div class="max-w-6xl mx-auto px-6 py-12 md:py-20 space-y-12">
    
    <header class="border-b border-night-700/60 pb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-candle/10 border border-amber-candle/30 text-amber-candle text-xs tracking-wider uppercase font-medium mb-4">
        <Compass class="w-3.5 h-3.5" />
        <span>Kompletní registratura</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl text-parchment-200 mb-4 font-semibold">
        Archiv badatelny
      </h1>
      <p class="text-parchment-400 font-light text-base sm:text-lg max-w-2xl leading-relaxed">
        Všechna témata na jednom stole. Každý spis propojuje zvukové vyprávění s přepisem textu, dobovými souvislostmi a citovanými prameny.
      </p>
    </header>

    <!-- FILTRAČNÍ LIŠTA -->
    <section class="space-y-6 bg-night-800/40 border border-night-700/70 p-6 rounded-2xl backdrop-blur-sm">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
        <div class="md:col-span-8 relative">
          <label for="searchInput" class="sr-only">Hledat ve spisech</label>
          <Search class="w-4 h-4 text-parchment-600 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" />
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Hledat v názvech, osobách a tématech..." 
            class="w-full bg-night-900 border border-night-700 rounded-xl pl-11 pr-4 py-3 text-sm text-parchment-200 placeholder:text-parchment-600 focus:outline-none focus:border-amber-candle/60 transition"
          />
        </div>

        <div class="md:col-span-4">
          <label for="centurySelect" class="sr-only">Vyberte staletí</label>
          <select 
            id="centurySelect" 
            class="w-full bg-night-900 border border-night-700 rounded-xl px-4 py-3 text-sm text-parchment-300 focus:outline-none focus:border-amber-candle/60 transition cursor-pointer"
          >
            {centuries.map((century) => (
              <option value={century === "Všechna staletí" ? "" : century}>{century}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-night-700/50">
        <span class="text-xs uppercase tracking-wider text-parchment-600 font-medium mr-2 flex items-center gap-1.5">
          <Filter class="w-3.5 h-3.5 text-amber-candle" /> Téma:
        </span>
        {categories.map((cat, idx) => (
          <button 
            type="button"
            data-category-filter={cat === "Vše" ? "" : cat}
            class={`category-btn text-xs px-3.5 py-1.5 rounded-full border transition duration-200 ${
              idx === 0 
                ? "bg-amber-candle text-night-950 border-amber-candle font-medium active" 
                : "border-night-700 text-parchment-400 hover:text-amber-candle hover:border-amber-candle/40"
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

      <div class="text-xs text-parchment-600 font-mono">
        Zobrazeno záznamů: <span id="visibleCount" class="text-amber-candle font-semibold">{records.length}</span> z {records.length}
      </div>
    </section>

    <!-- MŘÍŽKA ZÁZNAMŮ -->
    <div id="recordsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {records.map((rec) => (
        <div 
          class="record-item"
          data-title={rec.title.toLowerCase()}
          data-annotation={rec.annotation.toLowerCase()}
          data-category={rec.category}
          data-century={rec.century}
        >
          <RecordCard record={rec} />
        </div>
      ))}
    </div>

    <!-- ŽÁDNÝ VÝSLEDEK -->
    <div id="noResults" class="hidden text-center py-20 border border-dashed border-night-700 rounded-2xl bg-night-800/20">
      <BookX class="w-12 h-12 text-parchment-600 mx-auto mb-4" />
      <h3 class="font-serif text-xl text-parchment-200 mb-2">V tomto fondu nebyl nalezen žádný spis</h3>
      <p class="text-xs text-parchment-600 font-light max-w-sm mx-auto">
        Zkuste upravit hledané slovo nebo přepněte filtr staletí.
      </p>
    </div>

  </div>
</Layout>

<script>
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const centurySelect = document.getElementById('centurySelect') as HTMLSelectElement;
  const categoryButtons = document.querySelectorAll('.category-btn');
  const items = document.querySelectorAll('.record-item');
  const noResults = document.getElementById('noResults');
  const visibleCount = document.getElementById('visibleCount');

  let activeCategory = '';
  let activeCentury = '';
  let searchQuery = '';

  function filterItems() {
    let visible = 0;

    items.forEach((itemEl) => {
      const item = itemEl as HTMLElement;
      const title = item.getAttribute('data-title') || '';
      const annotation = item.getAttribute('data-annotation') || '';
      const category = item.getAttribute('data-category') || '';
      const century = item.getAttribute('data-century') || '';

      const matchesSearch = !searchQuery || title.includes(searchQuery) || annotation.includes(searchQuery);
      const matchesCategory = !activeCategory || category.toLowerCase() === activeCategory.toLowerCase();
      const matchesCentury = !activeCentury || century === activeCentury;

      if (matchesSearch && matchesCategory && matchesCentury) {
        item.style.display = 'block';
        visible++;
      } else {
        item.style.display = 'none';
      }
    });

    if (visibleCount) visibleCount.textContent = String(visible);
    if (noResults) {
      if (visible === 0) noResults.classList.remove('hidden');
      else noResults.classList.add('hidden');
    }
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
    filterItems();
  });

  centurySelect?.addEventListener('change', (e) => {
    activeCentury = (e.target as HTMLSelectElement).value;
    filterItems();
  });

  categoryButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      categoryButtons.forEach((b) => {
        b.classList.remove('bg-amber-candle', 'text-night-950', 'border-amber-candle', 'font-medium', 'active');
        b.classList.add('border-night-700', 'text-parchment-400');
      });

      btn.classList.add('bg-amber-candle', 'text-night-950', 'border-amber-candle', 'font-medium', 'active');
      btn.classList.remove('border-night-700', 'text-parchment-400');

      activeCategory = btn.getAttribute('data-category-filter') || '';
      filterItems();
    });
  });
</script>
