---
import Layout from '../../layouts/Layout.astro';
import { getRecordBySlug, getArchiveRecords } from '../../lib/notion';
import { 
  ArrowLeft, 
  Clock, 
  Calendar, 
  ExternalLink, 
  Share2, 
  Volume2, 
  ChevronRight, 
  BookX, 
  FileText,
  BookOpen,
  Moon
} from 'lucide-astro';

const param = Astro.params.slug || Astro.params.id;
const data = param ? await getRecordBySlug(param) : null;

// Automatický 301 redirect z ošklivého ID na čistý slug
if (data?.record && param !== data.record.slug) {
  return Astro.redirect(`/archiv/${data.record.slug}`, 301);
}

const record = data?.record;
const content = data?.content || "";

// Zda existují externí audio či čtenářské platformy
const hasAudioPlatforms = Boolean(record?.spotifyUrl || record?.seznamUrl);

// Sousední záznamy pro spodní navigaci
const allRecords = await getArchiveRecords();
const currentIndex = record ? allRecords.findIndex((r) => r.id === record.id) : -1;
const prevRecord = currentIndex > 0 ? allRecords[currentIndex - 1] : null;
const nextRecord = currentIndex >= 0 && currentIndex < allRecords.length - 1 ? allRecords[currentIndex + 1] : null;

// Strukturovaná data pro SEO a AI vyhledávače
const structuredData = record ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": record.title,
  "description": record.annotation,
  "datePublished": record.date,
  "author": {
    "@type": "Person",
    "name": "Archivářka Jitka"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Noční Knihovna"
  }
} : null;
---

<Layout 
  title={record ? record.title : "Spis nenalezen"}
  description={record?.annotation || "Záznam nebyl v badatelně nalezen."}
>
  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}

  <article class="max-w-4xl mx-auto px-6 py-12 md:py-20 space-y-10">
    
    <!-- DROBEČKOVÁ NAVIGACE -->
    <nav aria-label="Navigace v archivu" class="flex items-center gap-2 text-xs uppercase tracking-wider text-parchment-600">
      <a href="/archiv" class="hover:text-amber-candle transition inline-flex items-center gap-1.5">
        <ArrowLeft class="w-3.5 h-3.5" /> Archiv badatelny
      </a>
      {record && (
        <>
          <ChevronRight class="w-3 h-3 text-night-700" />
          <span class="text-parchment-400">{record.century}</span>
        </>
      )}
    </nav>

    {!record ? (
      <div class="text-center py-24 border border-dashed border-night-700 rounded-2xl bg-night-800/20 space-y-4">
        <BookX class="w-12 h-12 text-amber-candle/60 mx-auto" />
        <h1 class="font-serif text-2xl sm:text-3xl text-parchment-200">Tento spis nebyl v badatelně nalezen</h1>
        <p class="text-parchment-400 text-sm font-light max-w-md mx-auto">
          Je možné, že byl přesunut pod jinou signaturu nebo zatím nebyl zpřístupněn.
        </p>
        <div class="pt-4">
          <a href="/archiv" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-amber-candle text-night-950 font-semibold text-xs uppercase tracking-wider hover:bg-amber-300 transition">
            Zpět do archivu
          </a>
        </div>
      </div>
    ) : (
      <>
        <!-- HLAVIČKA SPISU S METADATY A SDÍLENÍM -->
        <header class="space-y-6 border-b border-night-700/60 pb-10">
          <div class="flex flex-wrap items-center justify-between gap-4 text-xs">
            <div class="flex flex-wrap items-center gap-3">
              <span class="px-2.5 py-1 rounded bg-amber-candle/10 text-amber-candle border border-amber-candle/20 font-medium tracking-wide">
                {record.category}
              </span>
              <span class="px-2.5 py-1 rounded bg-night-800 text-parchment-300 border border-night-700 font-mono">
                {record.century}
              </span>
              {record.duration && (
                <span class="text-parchment-600 flex items-center gap-1 font-mono">
                  <Clock class="w-3.5 h-3.5 text-amber-brass" /> {record.duration}
                </span>
              )}
              <span class="text-parchment-600 flex items-center gap-1 font-mono">
                <Calendar class="w-3.5 h-3.5 text-amber-brass" /> {record.date}
              </span>
            </div>

            <!-- Tlačítko sdílení -->
            <div class="relative inline-block text-left" id="shareContainer">
              <button 
                type="button" 
                id="mainShareBtn" 
                class="px-3 py-1.5 bg-night-900 border border-night-700 hover:border-amber-candle/50 text-parchment-300 hover:text-amber-candle text-xs rounded-lg inline-flex items-center gap-1.5 transition"
              >
                <Share2 class="w-3.5 h-3.5" />
                <span id="shareBtnLabel">Sdílet spis</span>
              </button>

              <!-- Rozbalovací nabídka (desktop) -->
              <div 
                id="shareDropdown" 
                class="hidden absolute right-0 mt-2 w-48 rounded-xl bg-night-950 border border-night-700 shadow-2xl p-1.5 z-50 backdrop-blur"
              >
                <button 
                  type="button" 
                  id="copyLinkAction" 
                  class="w-full text-left px-3 py-2 text-xs text-parchment-300 hover:text-night-950 hover:bg-amber-candle rounded-lg transition flex items-center justify-between"
                >
                  <span>Kopírovat odkaz</span>
                  <span id="copyFeedback" class="text-[10px] uppercase font-mono text-amber-candle"></span>
                </button>

                <a 
                  id="waShareLink" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="w-full px-3 py-2 text-xs text-parchment-300 hover:text-night-950 hover:bg-green-500 rounded-lg transition flex items-center gap-2"
                >
                  WhatsApp
                </a>

                <a 
                  id="fbShareLink" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="w-full px-3 py-2 text-xs text-parchment-300 hover:text-night-950 hover:bg-blue-600 rounded-lg transition flex items-center gap-2"
                >
                  Facebook
                </a>
              </div>
            </div>
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl text-parchment-200 font-semibold leading-[1.2]">
            {record.title}
          </h1>

          <p class="text-base sm:text-lg text-parchment-400 font-light leading-relaxed max-w-3xl">
            {record.annotation}
          </p>
        </header>

<!-- MULTIMEDIÁLNÍ HLAVIČKA: VIDEO NEBO TITULNÍ OBRAZ -->
        {record.youtubeId ? (
          <div class="rounded-2xl overflow-hidden border border-night-700 bg-night-950 aspect-video shadow-2xl relative">
            <iframe 
              class="w-full h-full"
              src={`https://www.youtube-nocookie.com/embed/${record.youtubeId}?rel=0&modestbranding=1`} 
              title={record.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen
            ></iframe>
          </div>
        ) : record.imageUrl ? (
          <div class="rounded-2xl overflow-hidden border border-night-700 bg-night-950 max-h-[460px] shadow-2xl relative">
            <img 
              src={record.imageUrl} 
              alt={record.title} 
              class="w-full h-full object-cover filter brightness-90 contrast-105"
            />
          </div>
        ) : null}

        <!-- LIŠTA PRO POSLECH (POUZE POKUD EXISTUJE SPOTIFY NEBO SEZNAM URL) -->
        {hasAudioPlatforms && (
          <div class="bg-night-800/70 border border-night-700/80 rounded-xl p-4 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-lg bg-green-950/60 border border-green-800/50 flex items-center justify-center text-green-400">
                <Volume2 class="w-4 h-4" />
              </div>
              <div>
                <span class="text-xs font-medium text-parchment-200 block">Poslech do uší</span>
                <span class="text-[11px] text-parchment-600 block">Dostupné na streamovacích platformách</span>
              </div>
            </div>

            <div class="flex items-center gap-3">
              {record.spotifyUrl && (
                <a 
                  href={record.spotifyUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="px-4 py-2 bg-night-900 border border-night-700 hover:border-green-500/50 text-parchment-300 hover:text-green-400 text-xs font-medium rounded-lg inline-flex items-center gap-1.5 transition"
                >
                  Spotify <ExternalLink class="w-3 h-3" />
                </a>
              )}
              {record.seznamUrl && (
                <a 
                  href={record.seznamUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="px-4 py-2 bg-night-900 border border-night-700 hover:border-red-500/50 text-parchment-300 hover:text-red-400 text-xs font-medium rounded-lg inline-flex items-center gap-1.5 transition"
                >
                  Seznam Médium <ExternalLink class="w-3 h-3" />
                </a>
              )}
            </div>
          </div>
        )}

        <!-- SEKCE ČTENÍ S PŘEPÍNAČEM REŽIMŮ (PERGAMEN / NOČNÍ STŮL) -->
        <section class="pt-6 border-t border-night-700/60 space-y-6">
          <div class="flex items-center justify-between flex-wrap gap-4">
            <div class="inline-flex items-center gap-2 text-xs uppercase tracking-widest text-amber-candle font-medium">
              <FileText class="w-4 h-4" />
              <span>Čtení a dochované záznamy</span>
            </div>

            <!-- Přepínač režimu čtení -->
            <div class="inline-flex items-center p-1 rounded-lg bg-night-900 border border-night-700/80 text-xs shadow-inner">
              <button 
                type="button" 
                id="modeParchmentBtn" 
                class="px-3 py-1.5 rounded-md transition flex items-center gap-1.5 text-night-950 bg-amber-candle font-medium shadow-sm"
              >
                <BookOpen class="w-3.5 h-3.5" /> Pergamen
              </button>
              <button 
                type="button" 
                id="modeNightBtn" 
                class="px-3 py-1.5 rounded-md transition flex items-center gap-1.5 text-parchment-400 hover:text-parchment-200"
              >
                <Moon class="w-3.5 h-3.5" /> Noční stůl
              </button>
            </div>
          </div>

          <!-- Karta s listem spisu -->
          <div id="readingPaper" class="reader-mode-parchment rounded-2xl transition-all duration-300">
            <div class="badatelna-content max-w-2xl mx-auto">
              <Fragment set:html={content} />
            </div>
          </div>
        </section>

        <!-- SOUSEDNÍ SPISY -->
        <nav aria-label="Sousední spisy" class="pt-12 border-t border-night-700/60 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevRecord ? (
            <a 
              href={`/archiv/${prevRecord.slug}`} 
              class="group p-5 rounded-xl border border-night-700/60 bg-night-800/30 hover:bg-night-800/80 hover:border-amber-candle/30 transition flex flex-col justify-between"
            >
              <span class="text-[11px] uppercase tracking-wider text-parchment-600 block mb-1">← Novější spis</span>
              <span class="font-serif text-sm text-parchment-300 group-hover:text-amber-candle transition line-clamp-1">
                {prevRecord.title}
              </span>
            </a>
          ) : <div />}

          {nextRecord ? (
            <a 
              href={`/archiv/${nextRecord.slug}`} 
              class="group p-5 rounded-xl border border-night-700/60 bg-night-800/30 hover:bg-night-800/80 hover:border-amber-candle/30 transition flex flex-col justify-between text-right"
            >
              <span class="text-[11px] uppercase tracking-wider text-parchment-600 block mb-1">Starší spis →</span>
              <span class="font-serif text-sm text-parchment-300 group-hover:text-amber-candle transition line-clamp-1">
                {nextRecord.title}
              </span>
            </a>
          ) : <div />}
        </nav>
      </>
    )}

  </article>
</Layout>

<script>
  // 1. Logika sdílení (Desktop i Mobile)
  const shareBtn = document.getElementById('mainShareBtn');
  const dropdown = document.getElementById('shareDropdown');
  const copyAction = document.getElementById('copyLinkAction');
  const copyFeedback = document.getElementById('copyFeedback');
  const waLink = document.getElementById('waShareLink') as HTMLAnchorElement;
  const fbLink = document.getElementById('fbShareLink') as HTMLAnchorElement;

  const pageUrl = window.location.href;
  const pageTitle = document.title;

  if (waLink) waLink.href = `https://api.whatsapp.com/send?text=${encodeURIComponent(pageTitle + ' — ' + pageUrl)}`;
  if (fbLink) fbLink.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`;

  shareBtn?.addEventListener('click', async (e) => {
    e.stopPropagation();
    if (navigator.share && window.innerWidth < 768) {
      try {
        await navigator.share({
          title: pageTitle,
          text: 'Záznam z badatelny Noční Knihovny:',
          url: pageUrl,
        });
        return;
      } catch (err) {}
    }
    dropdown?.classList.toggle('hidden');
  });

  copyAction?.addEventListener('click', async (e) => {
    e.stopPropagation();
    try {
      await navigator.clipboard.writeText(pageUrl);
      if (copyFeedback) {
        copyFeedback.textContent = '✓ Zkopírováno';
        setTimeout(() => {
          copyFeedback.textContent = '';
          dropdown?.classList.add('hidden');
        }, 1500);
      }
    } catch (err) {
      console.error('Chyba při kopírování', err);
    }
  });

  document.addEventListener('click', () => {
    dropdown?.classList.add('hidden');
  });

  // 2. Logika přepínače režimu čtení (Pergamen vs. Noční stůl)
  const readingPaper = document.getElementById('readingPaper');
  const modeParchmentBtn = document.getElementById('modeParchmentBtn');
  const modeNightBtn = document.getElementById('modeNightBtn');

  function setReaderMode(mode: 'parchment' | 'night') {
    if (mode === 'night') {
      readingPaper?.classList.remove('reader-mode-parchment');
      readingPaper?.classList.add('reader-mode-night');

      modeNightBtn?.classList.add('text-night-950', 'bg-amber-candle', 'font-medium', 'shadow-sm');
      modeNightBtn?.classList.remove('text-parchment-400');
      modeParchmentBtn?.classList.remove('text-night-950', 'bg-amber-candle', 'font-medium', 'shadow-sm');
      modeParchmentBtn?.classList.add('text-parchment-400');
      localStorage.setItem('badatelna_reader_mode', 'night');
    } else {
      readingPaper?.classList.add('reader-mode-parchment');
      readingPaper?.classList.remove('reader-mode-night');

      modeParchmentBtn?.classList.add('text-night-950', 'bg-amber-candle', 'font-medium', 'shadow-sm');
      modeParchmentBtn?.classList.remove('text-parchment-400');
      modeNightBtn?.classList.remove('text-night-950', 'bg-amber-candle', 'font-medium', 'shadow-sm');
      modeNightBtn?.classList.add('text-parchment-400');
      localStorage.setItem('badatelna_reader_mode', 'parchment');
    }
  }

  const savedMode = (localStorage.getItem('badatelna_reader_mode') as 'parchment' | 'night') || 'parchment';
  setReaderMode(savedMode);

  modeParchmentBtn?.addEventListener('click', () => setReaderMode('parchment'));
  modeNightBtn?.addEventListener('click', () => setReaderMode('night'));
</script>

<style is:global>
  /* =========================================
     1. KONTENJERY REŽIMU ČTENÍ
     ========================================= */
  
  /* PERGAMEN (Výchozí režim starého papíru) */
  .reader-mode-parchment {
    background-color: #f3eee3;
    padding: 2.25rem 1.5rem;
    border: 1px solid #dfd5c2;
    box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(212, 154, 69, 0.15);
  }

  @media (min-width: 640px) {
    .reader-mode-parchment {
      padding: 3.5rem 3rem;
    }
  }

  /* NOČNÍ STŮL (Tmavý režim) */
  .reader-mode-night {
    background-color: rgba(22, 25, 34, 0.7);
    padding: 2rem 1.25rem;
    border: 1px solid rgba(43, 48, 64, 0.8);
    box-shadow: none;
  }

  @media (min-width: 640px) {
    .reader-mode-night {
      padding: 3rem 2.5rem;
    }
  }

  /* =========================================
     2. SPOLEČNÁ KNIŽNÍ TYPOGRAFIE
     ========================================= */
  .badatelna-content {
    font-size: 1.0625rem;
    line-height: 1.85;
    font-weight: 300;
  }

  .badatelna-content p {
    margin-bottom: 1.5rem;
  }

  .badatelna-content h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.75rem;
    font-weight: 600;
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
  }

  .badatelna-content h3 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.35rem;
    font-weight: 500;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .badatelna-content ul {
    list-style-type: disc !important;
    padding-left: 1.75rem !important;
    margin-top: 1rem;
    margin-bottom: 1.75rem;
  }

  .badatelna-content ol {
    list-style-type: decimal !important;
    padding-left: 1.75rem !important;
    margin-top: 1rem;
    margin-bottom: 1.75rem;
  }

  .badatelna-content li {
    margin-bottom: 0.6rem;
    line-height: 1.75;
  }

  .badatelna-content blockquote {
    padding: 1.1rem 1.4rem;
    margin: 2rem 0;
    border-radius: 0 0.75rem 0.75rem 0;
    font-style: italic;
    line-height: 1.75;
  }

  .badatelna-content hr {
    border: 0;
    margin: 3rem 0;
  }

  /* =========================================
     3. BAREVNÉ SCHÉMA: PERGAMEN
     ========================================= */
  .reader-mode-parchment .badatelna-content {
    color: #26211b; /* Tmavý duběnkový inkoust */
  }

  .reader-mode-parchment .badatelna-content h2 {
    color: #15110d;
    border-bottom: 1px solid rgba(168, 120, 52, 0.35);
  }

  .reader-mode-parchment .badatelna-content h3 {
    color: #5c3f15;
  }

  .reader-mode-parchment .badatelna-content li {
    color: #2a241e;
  }

  .reader-mode-parchment .badatelna-content li::marker {
    color: #a36d22;
  }

  .reader-mode-parchment .badatelna-content strong {
    color: #120e0a;
    font-weight: 600;
  }

  .reader-mode-parchment .badatelna-content em {
    color: #3b332a;
  }

  .reader-mode-parchment .badatelna-content blockquote {
    border-left: 3px solid #b37e2a;
    background: #eae2d1;
    color: #332b21;
  }

  .reader-mode-parchment .badatelna-content hr {
    border-top: 1px solid #d8cbaf;
  }

  .reader-mode-parchment .badatelna-content a {
    color: #8c5712;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .reader-mode-parchment .badatelna-content a:hover {
    color: #543407;
  }

  /* =========================================
     4. BAREVNÉ SCHÉMA: NOČNÍ STŮL
     ========================================= */
  .reader-mode-night .badatelna-content {
    color: #d5cdbf;
  }

  .reader-mode-night .badatelna-content h2 {
    color: #e8e2d5;
    border-bottom: 1px solid rgba(212, 154, 69, 0.25);
  }

  .reader-mode-night .badatelna-content h3 {
    color: #d49a45;
  }

  .reader-mode-night .badatelna-content li {
    color: #e8e2d5;
  }

  .reader-mode-night .badatelna-content li::marker {
    color: #d49a45;
  }

  .reader-mode-night .badatelna-content strong {
    color: #f5f0e6;
    font-weight: 600;
  }

  .reader-mode-night .badatelna-content em {
    color: #e8e2d5;
  }

  .reader-mode-night .badatelna-content blockquote {
    border-left: 3px solid #d49a45;
    background: rgba(15, 17, 21, 0.7);
    color: #e8e2d5;
  }

  .reader-mode-night .badatelna-content hr {
    border-top: 1px solid #232836;
  }

  .reader-mode-night .badatelna-content a {
    color: #d49a45;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .reader-mode-night .badatelna-content a:hover {
    color: #f5c06b;
  }
</style>
