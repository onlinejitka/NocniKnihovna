---
import Layout from '../../layouts/Layout.astro';
import { getEpisodeById } from '../../lib/notion';
import { Clock, Calendar, ArrowLeft, ExternalLink, Bookmark } from 'lucide-astro';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/epizody');
}

const data = await getEpisodeById(id);

if (!data) {
  return Astro.redirect('/404');
}

const { episode, content } = data;
---

<Layout title={episode.title} description={episode.annotation}>
  <article class="max-w-4xl mx-auto px-6 py-12">
    
    <a href="/epizody" class="inline-flex items-center gap-1.5 text-xs uppercase tracking-wider text-parchment-600 hover:text-amber-candle transition mb-8">
      <ArrowLeft class="w-3.5 h-3.5" /> Zpět do archivu
    </a>

    <!-- Hlavička záznamu -->
    <header class="mb-10">
      <div class="flex items-center gap-3 text-xs mb-4">
        <span class="px-2.5 py-1 rounded bg-amber-candle/10 text-amber-candle border border-amber-candle/20 font-medium">
          {episode.century}
        </span>
        <span class="text-parchment-600 flex items-center gap-1">
          <Clock class="w-3.5 h-3.5" /> {episode.duration}
        </span>
        <span class="text-parchment-600 flex items-center gap-1">
          <Calendar class="w-3.5 h-3.5" /> {episode.date}
        </span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl text-parchment-200 leading-tight mb-4">
        {episode.title}
      </h1>
      <p class="text-lg text-parchment-400 font-light leading-relaxed">
        {episode.annotation}
      </p>
    </header>

    <!-- YouTube Embed -->
    {episode.youtubeId && (
      <div class="mb-12 rounded-2xl overflow-hidden border border-night-700 bg-night-950 aspect-video shadow-2xl">
        <iframe 
          class="w-full h-full"
          src={`https://www.youtube-nocookie.com/embed/${episode.youtubeId}`} 
          title={episode.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen
        ></iframe>
      </div>
    )}

    <!-- Odkazy na platformy -->
    <div class="bg-night-800/60 border border-night-700 rounded-xl p-4 mb-12 flex flex-wrap items-center justify-between gap-4">
      <span class="text-xs uppercase tracking-wider text-parchment-400 font-medium flex items-center gap-2">
        <Bookmark class="w-4 h-4 text-amber-candle" /> Zvukový záznam bez obrazu
      </span>
      <div class="flex gap-4">
        <a 
          href={episode.spotifyUrl} 
          target="_blank" 
          rel="noopener"
          class="text-xs font-semibold px-4 py-2 bg-green-900/30 text-green-300 border border-green-700/50 rounded-lg hover:bg-green-800/40 transition inline-flex items-center gap-1.5"
        >
          Přehrát na Spotify <ExternalLink class="w-3 h-3" />
        </a>
      </div>
    </div>

    <!-- Tělo z Notionu (Časová osa, literatura, přepis) -->
    <div class="prose prose-invert max-w-none prose-headings:font-serif prose-headings:text-parchment-200 prose-p:text-parchment-400 prose-p:font-light prose-p:leading-relaxed prose-a:text-amber-candle prose-li:text-parchment-400 prose-strong:text-parchment-200 prose-hr:border-night-700">
      <Fragment set:html={content} />
    </div>

  </article>
</Layout>
