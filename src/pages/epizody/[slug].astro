---
import Layout from '../../layouts/Layout.astro';
import { getEpisodeBySlug, getEpisodes } from '../../lib/notion';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/epizody');
}

const data = await getEpisodeBySlug(slug);

if (!data) {
  return Astro.redirect('/404');
}

const { episode, content } = data;

// Načtení sousedních epizod pro navigaci
const allEpisodes = await getEpisodes();
const currentIndex = allEpisodes.findIndex((e) => e.id === episode.id);
const prevEpisode = currentIndex > 0 ? allEpisodes[currentIndex - 1] : null;
const nextEpisode = currentIndex < allEpisodes.length - 1 ? allEpisodes[currentIndex + 1] : null;

// JSON-LD strukturovaná data pro Google / Seznam
const structuredData = {
  "@context": "https://schema.org",
  "@type": "PodcastEpisode",
  "name": episode.title,
  "description": episode.annotation,
  "datePublished": episode.date,
  "duration": episode.duration,
  "url": `https://nocniknihovna.cz/epizody/${episode.id}`,
  "partOfSeries": {
    "@type": "PodcastSeries",
    "name": "Noční Knihovna",
    "url": "https://nocniknihovna.cz"
  }
};
---

<Layout 
  title={`${episode.title} | Noční Knihovna`}
  description={episode.annotation}
>
  <!-- SEO Strukturovaná data -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <article class="max-w-4xl mx-auto px-6 py-12 md:py-20 space-y-12">
    
    <!-- DROBEČKOVÁ NAVIGACE -->
    <nav aria-label="Navigace v archivu" class="flex items-center gap-2 text-xs uppercase tracking-wider text-parchment-600">
      <a href="/epizody" class="hover:text-amber-candle transition inline-flex items-center gap-1.5">
        <ArrowLeft class="w-3.5 h-3.5" /> Registratura
      </a>
      <ChevronRight class="w-3 h-3 text-night-700" />
      <span class="text-parchment-400">{episode.century}</span>
    </nav>

    <!-- HLAVIČKA EPIZODY (PASPORT SVAZKU) -->
    <header class="space-y-6 border-b border-night-700/60 pb-10">
      <div class="flex flex-wrap items-center gap-3 text-xs">
        <span class="px-2.5 py-1 rounded bg-amber-candle/10 text-amber-candle border border-amber-candle/20 font-medium tracking-wide">
          {episode.category}
        </span>
        <span class="px-2.5 py-1 rounded bg-night-800 text-parchment-300 border border-night-700 font-mono">
          {episode.century}
        </span>
        <span class="text-parchment-600 flex items-center gap-1 font-mono">
          <Clock class="w-3.5 h-3.5 text-amber-brass" /> {episode.duration}
        </span>
        <span class="text-parchment-600 flex items-center gap-1 font-mono">
          <Calendar class="w-3.5 h-3.5 text-amber-brass" /> {episode.date}
        </span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl text-parchment-200 font-semibold leading-[1.2]">
        {episode.title}
      </h1>

      <p class="text-base sm:text-lg text-parchment-400 font-light leading-relaxed max-w-3xl">
        {episode.annotation}
      </p>
    </header>

    <!-- MULTIMEDIÁLNÍ PŘEHRÁVAČ -->
    <section class="space-y-4">
      {episode.youtubeId ? (
        <div class="rounded-2xl overflow-hidden border border-night-700 bg-night-950 aspect-video shadow-2xl relative">
          <iframe 
            class="w-full h-full"
            src={`https://www.youtube-nocookie.com/embed/${episode.youtubeId}?rel=0&modestbranding=1`} 
            title={episode.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen
          ></iframe>
        </div>
      ) : (
        <div class="rounded-2xl border border-dashed border-night-700 bg-night-800/40 p-12 text-center">
          <Volume2 class="w-10 h-10 text-amber-candle mx-auto mb-3" />
          <p class="font-serif text-lg text-parchment-200">K tomuto spisu je dostupný audio záznam</p>
          <p class="text-xs text-parchment-600 mt-1">Využijte poslech na platformě Spotify níže.</p>
        </div>
      )}

      <!-- Audio rozcestník & Sdílení -->
      <div class="bg-night-800/70 border border-night-700/80 rounded-xl p-4 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-lg bg-green-950/60 border border-green-800/50 flex items-center justify-center text-green-400">
            <Volume2 class="w-4 h-4" />
          </div>
          <div>
            <span class="text-xs font-medium text-parchment-200 block">Poslech bez obrazu</span>
            <span class="text-[11px] text-parchment-600 block">Streamujte epizodu do sluchátek na pozadí</span>
          </div>
        </div>

        <div class="flex items-center gap-3">
          {episode.spotifyUrl && episode.spotifyUrl !== '#' && (
            <a 
              href={episode.spotifyUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-4 py-2 bg-night-900 border border-night-700 hover:border-green-500/50 text-parchment-300 hover:text-green-400 text-xs font-medium rounded-lg inline-flex items-center gap-1.5 transition"
            >
              Spotify <ExternalLink class="w-3 h-3" />
            </a>
          )}
          <button 
            type="button" 
            id="copyShareBtn" 
            class="px-3 py-2 bg-night-900 border border-night-700 hover:border-amber-candle/50 text-parchment-400 hover:text-amber-candle text-xs rounded-lg inline-flex items-center gap-1.5 transition"
            title="Zkopírovat odkaz na spis"
          >
            <Share2 class="w-3.5 h-3.5" /> <span id="copyText">Sdílet</span>
          </button>
        </div>
      </div>
    </section>

    <!-- STRUKTUROVANÝ TEXT Z NOTIONU (Časová osa, prameny, přepis) -->
    <section class="pt-6 border-t border-night-700/60">
      <div class="prose prose-invert max-w-none 
        prose-headings:font-serif prose-headings:text-parchment-200 prose-headings:font-medium
        prose-h2:text-2xl prose-h2:border-b prose-h2:border-night-700/50 prose-h2:pb-3 prose-h2:mt-12 prose-h2:mb-6
        prose-h3:text-lg prose-h3:text-amber-candle prose-h3:mt-8
        prose-p:text-parchment-400 prose-p:font-light prose-p:leading-relaxed prose-p:text-base
        prose-a:text-amber-candle hover:prose-a:text-amber-300 prose-a:underline-offset-4
        prose-ul:text-parchment-400 prose-ul:font-light prose-li:my-1
        prose-strong:text-parchment-200 prose-strong:font-medium
        prose-blockquote:border-l-2 prose-blockquote:border-amber-candle/60 prose-blockquote:bg-night-800/40 prose-blockquote:py-2 prose-blockquote:px-5 prose-blockquote:rounded-r-lg prose-blockquote:italic prose-blockquote:text-parchment-300
        prose-hr:border-night-700/60
      ">
        <Fragment set:html={content} />
      </div>
    </section>

    <!-- SPODNÍ NAVIGACE MEZI ZÁZNAMY -->
    <nav aria-label="Sousední spisy" class="pt-12 border-t border-night-700/60 grid grid-cols-1 sm:grid-cols-2 gap-4">
      {prevEpisode ? (
        <a 
          href={`/epizody/${prevEpisode.id}`} 
          class="group p-5 rounded-xl border border-night-700/60 bg-night-800/30 hover:bg-night-800/80 hover:border-amber-candle/30 transition flex flex-col justify-between"
        >
          <span class="text-[11px] uppercase tracking-wider text-parchment-600 block mb-1">← Novější záznam</span>
          <span class="font-serif text-sm text-parchment-300 group-hover:text-amber-candle transition line-clamp-1">
            {prevEpisode.title}
          </span>
        </a>
      ) : <div />}

      {nextEpisode ? (
        <a 
          href={`/epizody/${nextEpisode.id}`} 
          class="group p-5 rounded-xl border border-night-700/60 bg-night-800/30 hover:bg-night-800/80 hover:border-amber-candle/30 transition flex flex-col justify-between text-right"
        >
          <span class="text-[11px] uppercase tracking-wider text-parchment-600 block mb-1">Starší záznam →</span>
          <span class="font-serif text-sm text-parchment-300 group-hover:text-amber-candle transition line-clamp-1">
            {nextEpisode.title}
          </span>
        </a>
      ) : <div />}
    </nav>

  </article>
</Layout>

<script>
  // Kopírování odkazu do schránky s vizuální odezvou
  const copyBtn = document.getElementById('copyShareBtn');
  const copyText = document.getElementById('copyText');

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (copyText) {
        copyText.textContent = 'Zkopírováno';
        setTimeout(() => {
          copyText.textContent = 'Sdílet';
        }, 2500);
      }
    } catch (err) {
      console.error('Nepodařilo se zkopírovat odkaz', err);
    }
  });
</script>
