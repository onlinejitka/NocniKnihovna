---
import Layout from '../layouts/Layout.astro';
import RecordCard from '../components/RecordCard.astro';
import { getLatestRecord, getArchiveRecords } from '../lib/notion';
import { Play, ArrowRight, BookOpen, ExternalLink, Headphones } from 'lucide-astro';

const latestRecord = await getLatestRecord();
const allRecords = await getArchiveRecords(7);
// Pokud máme více než 1 záznam, vezmeme další do mřížky; pokud je 1, ukážeme ho i dole
const recentRecords = allRecords.length > 1 ? allRecords.slice(1, 7) : allRecords;
---

<Layout title="Noční badatelna archivářky">
  <!-- HERO SEKCE -->
  <section class="relative pt-12 pb-20 md:py-28 overflow-hidden border-b border-night-700/40">
    <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Levý sloupec s textem a přehrávačem -->
      <div class="lg:col-span-7 space-y-6">

        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-parchment-200 leading-[1.15] font-semibold">
          Dějiny nejsou učebnice. <br />
          <span class="italic font-normal text-amber-candle">Jsou to lidské osudy</span>.
        </h1>

        <p class="text-parchment-400 text-base sm:text-lg font-light leading-relaxed max-w-xl">
          Otevírám pro vás zapomenuté kroniky, smolné knihy a staré prameny bez školní rigidity. Naslouchejte hlasům minulosti zprostředkovaným tak, že si je budete pamatovat.
        </p>

        <!-- Karta nejnovějšího spisu -->
        {latestRecord && (
          <div class="bg-night-800/80 border border-amber-brass/40 rounded-xl p-5 shadow-2xl backdrop-blur relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-32 h-32 bg-amber-candle/5 rounded-full blur-2xl pointer-events-none"></div>
            <div class="text-[11px] uppercase tracking-widest text-amber-candle font-semibold mb-2 flex items-center gap-1.5">
              <Headphones class="w-3.5 h-3.5" /> Poslední záznam z badatelny
            </div>
            <h2 class="font-serif text-lg sm:text-xl text-parchment-200 mb-2 group-hover:text-amber-candle transition">
              <a href={`/archiv/${latestRecord.slug}`}>{latestRecord.title}</a>
            </h2>
            <p class="text-parchment-400 text-xs line-clamp-2 mb-4 font-light leading-relaxed">
              {latestRecord.annotation}
            </p>
            
            <div class="flex flex-wrap items-center gap-4 pt-3 border-t border-night-700/60">
              <a 
                href={`/archiv/${latestRecord.slug}`} 
                class="bg-amber-candle text-night-950 px-5 py-2.5 rounded-lg text-xs font-semibold uppercase tracking-wider flex items-center gap-2 hover:bg-amber-300 transition"
              >
                <Play class="w-3.5 h-3.5 fill-current" /> Otevřít spis
              </a>
              {latestRecord.spotifyUrl && (
                <a 
                  href={latestRecord.spotifyUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-parchment-400 hover:text-parchment-200 text-xs flex items-center gap-1.5 font-medium transition"
                >
                  Poslouchat na Spotify <ExternalLink class="w-3 h-3" />
                </a>
              )}
            </div>
          </div>
        )}

        <div class="flex items-center gap-4 pt-2 text-xs text-parchment-600">
          <span>Dostupné také na:</span>
          <span class="text-parchment-400 font-medium"><a href="https://open.spotify.com/show/033InV4LRiYrH5A1asOYHL" target="_blank" rel="noopener" class="hover:text-amber-candle transition" aria-label="YouTube">YouTube</a></span>
          <span>•</span>
          <span class="text-parchment-400 font-medium"><a href="https://open.spotify.com/show/033InV4LRiYrH5A1asOYHL" target="_blank" rel="noopener" class="hover:text-amber-candle transition" aria-label="Spotify">Spotify</a></span>
          <span>•</span>
          <span class="text-parchment-400 font-medium"><a href="https://open.spotify.com/show/033InV4LRiYrH5A1asOYHL" target="_blank" rel="noopener" class="hover:text-amber-candle transition" aria-label="Spotify">Apple Podcasts</a></span>
        </div>
      </div>

      <!-- Pravý sloupec s portrétem -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <div class="absolute -inset-1.5 bg-gradient-to-r from-amber-brass/20 to-amber-candle/20 rounded-2xl blur-lg"></div>
          <div class="relative rounded-2xl overflow-hidden border border-night-700 bg-night-800 shadow-2xl aspect-[4/5]">
            <img 
              src="/images/badatelna-hero.jpg" 
              alt="Archivářka Jitka v noční badatelně" 
              class="w-full h-full object-cover filter brightness-90 contrast-105 hover:scale-105 transition duration-700 ease-out"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-night-950 via-night-950/20 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6">
              <p class="font-serif italic text-sm text-parchment-300">
                „V archivech neodpočívá jen suchý úřední záznam, ale křik, láska a bázeň živých lidí.“
              </p>
              <span class="text-xs uppercase tracking-widest text-amber-candle mt-2 block font-medium">
                — Jitka, archivářka
              </span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- POSLEDNÍ SPISY Z ARCHIVU -->
  <section class="py-20 max-w-6xl mx-auto px-6">
    <div class="flex flex-col sm:flex-row items-baseline justify-between mb-12 gap-4">
      <div>
        <span class="text-xs font-semibold uppercase tracking-widest text-amber-candle block mb-1">Aktuálně vyloženo na stůl</span>
        <h2 class="font-serif text-3xl text-parchment-200">Nejnovější svazky v archivu</h2>
      </div>
      <a href="/archiv" class="text-sm text-parchment-400 hover:text-amber-candle flex items-center gap-1.5 transition">
        Otevřít kompletní registraturu <ArrowRight class="w-4 h-4" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {recentRecords.map((rec) => (
        <RecordCard record={rec} />
      ))}
    </div>
  </section>

  <!-- MANIFEST / FILOZOFIE PROJEKTU -->
  <section class="py-24 max-w-4xl mx-auto px-6 text-center">
    <div class="w-12 h-12 rounded-full border border-amber-candle/30 bg-night-800 text-amber-candle flex items-center justify-center mx-auto mb-6">
      <BookOpen class="w-5 h-5" />
    </div>
    <h2 class="font-serif text-3xl sm:text-4xl text-parchment-200 mb-6">
      Proč se dívat do minulosti očima archiváře?
    </h2>
    <p class="text-parchment-400 font-light text-base sm:text-lg leading-relaxed mb-8">
      Dějiny nejsou sled bitev a panovnických rodokmenů. Skutečná historie se odehrávala v šeru vesnických světnic, v městských šatlavách a na polních cestách. Noční Knihovna nehodnotí moderní optikou. Pouze čistí prach ze zažloutlých listin a nechává promluvit ty, kteří už sami mluvit nemohou.
    </p>
    <a 
      href="/o-projektu" 
      class="inline-block text-xs uppercase tracking-widest px-6 py-3 rounded-md bg-night-800 border border-night-700 text-parchment-200 hover:border-amber-candle hover:text-amber-candle transition duration-300"
    >
      Poznejte zázemí badatelny
    </a>
  </section>
</Layout>
