---
import Layout from '../layouts/Layout.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import { getLatestEpisode, getEpisodes, getArticles } from '../lib/notion';
import { Play, Sparkles, ArrowRight, BookOpen, ExternalLink, Headphones } from 'lucide-astro';

// Volání Notion API v reálném čase během requestu
const latestEpisode = await getLatestEpisode();
const recentEpisodes = (await getEpisodes(4)).slice(1); // Další 3 po té nejnovější
const recentArticles = await getArticles(3);
---

<Layout title="Noční badatelna archivářky Jitky">
  <!-- HERO SEKCE -->
  <section class="relative pt-12 pb-20 md:py-28 overflow-hidden border-b border-night-700/40">
    <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Typografická a interaktivní část -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-candle/10 border border-amber-candle/30 text-amber-candle text-xs tracking-wider uppercase font-medium">
          <Sparkles class="w-3.5 h-3.5" />
          <span>Nyní otevřeno: Nový svazek v archivu</span>
        </div>

        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-parchment-200 leading-[1.15] font-semibold">
          Dějiny nejsou učebnice. <br />
          <span class="italic font-normal text-amber-candle">Jsou to lidské osudy</span> psané voskem a inkoustem.
        </h1>

        <p class="text-parchment-400 text-base sm:text-lg font-light leading-relaxed max-w-xl">
          Vstupte do noční badatelny. Jsem archivářka Jitka a otevírám pro vás zapomenuté kroniky, smolné knihy a staré prameny bez školního patosu. Naslouchejte hlasům minulosti za svitu lampy.
        </p>

<!-- Karta nejnovější epizody (Hero Mini-Player) -->
        {latestEpisode && (
          <div class="bg-night-800/80 border border-amber-brass/40 rounded-xl p-5 shadow-2xl backdrop-blur relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-32 h-32 bg-amber-candle/5 rounded-full blur-2xl pointer-events-none"></div>
            <div class="text-[11px] uppercase tracking-widest text-amber-candle font-semibold mb-2 flex items-center gap-1.5">
              <Headphones class="w-3.5 h-3.5" /> Poslední záznam z badatelny
            </div>
            <h2 class="font-serif text-lg sm:text-xl text-parchment-200 mb-2 group-hover:text-amber-candle transition">
              <a href={`/epizody/${latestEpisode.slug}`}>{latestEpisode.title}</a>
            </h2>
            <p class="text-parchment-400 text-xs line-clamp-2 mb-4 font-light leading-relaxed">
              {latestEpisode.annotation}
            </p>
            
            <div class="flex flex-wrap items-center gap-4 pt-3 border-t border-night-700/60">
              <a 
                href={`/epizody/${latestEpisode.slug}`} 
                class="bg-amber-candle text-night-950 px-5 py-2.5 rounded-lg text-xs font-semibold uppercase tracking-wider flex items-center gap-2 hover:bg-amber-300 transition"
              >
                <Play class="w-3.5 h-3.5 fill-current" /> Přehrát záznam
              </a>
              <a 
                href={latestEpisode.spotifyUrl} 
                target="_blank" 
                rel="noopener" 
                class="text-parchment-400 hover:text-parchment-200 text-xs flex items-center gap-1.5 font-medium transition"
              >
                Poslouchat na Spotify <ExternalLink class="w-3 h-3" />
              </a>
            </div>
          </div>
        )}

        <div class="flex items-center gap-4 pt-2 text-xs text-parchment-600">
          <span>Dostupné také na:</span>
          <span class="text-parchment-400 font-medium">YouTube</span>
          <span>•</span>
          <span class="text-parchment-400 font-medium">Spotify</span>
          <span>•</span>
          <span class="text-parchment-400 font-medium">Apple Podcasts</span>
        </div>
      </div>

      <!-- Vizuální atmosférická část -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <div class="absolute -inset-1.5 bg-gradient-to-r from-amber-brass/20 to-amber-candle/20 rounded-2xl blur-lg"></div>
          <div class="relative rounded-2xl overflow-hidden border border-night-700 bg-night-800 shadow-2xl aspect-[4/5]">
            <!-- Vizuál badatelny / portrét autorky -->
            <img 
              src="/images/badatelna-hero.jpg" 
              alt="Archivářka Jitka v noční badatelně" 
              class="w-full h-full object-cover filter brightness-90 contrast-105 hover:scale-105 transition duration-700 ease-out"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-night-950 via-night-950/20 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6">
              <p class="font-serif italic text-sm text-parchment-300">
                „V archivech neodpočívá jen suchý úřední záznam, ale křik, láska a bázeň živých lidí.“
              </p>
              <span class="text-xs uppercase tracking-widest text-amber-candle mt-2 block font-medium">
                — Jitka, archivářka
              </span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- POSLEDNÍ SVAZKY Z ARCHIVU -->
  <section class="py-20 max-w-6xl mx-auto px-6">
    <div class="flex flex-col sm:flex-row items-baseline justify-between mb-12 gap-4">
      <div>
        <span class="text-xs font-semibold uppercase tracking-widest text-amber-candle block mb-1">Katalog nahrávek</span>
        <h2 class="font-serif text-3xl text-parchment-200">Nejnovější svazky v archivu</h2>
      </div>
      <a href="/epizody" class="text-sm text-parchment-400 hover:text-amber-candle flex items-center gap-1.5 transition">
        Otevřít kompletní katalog <ArrowRight class="w-4 h-4" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {recentEpisodes.map((ep) => (
        <EpisodeCard episode={ep} />
      ))}
    </div>
  </section>

  <!-- LISTY Z BADATELNY (BLOG / SEZNAM MÉDIUM) -->
  <section class="py-20 bg-night-950/60 border-y border-night-700/40">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex justify-between items-baseline mb-12">
        <div>
          <span class="text-xs font-semibold uppercase tracking-widest text-amber-candle block mb-1">Čtení k pramenům</span>
          <h2 class="font-serif text-3xl text-parchment-200">Listy z badatelny</h2>
        </div>
        <a href="/clanky" class="text-sm text-parchment-400 hover:text-amber-candle flex items-center gap-1.5 transition">
          Všechny texty <ArrowRight class="w-4 h-4" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {recentArticles.map((art) => (
          <article class="border-b md:border-b-0 md:border-r border-night-700/60 pb-6 md:pb-0 md:pr-8 last:border-none flex flex-col justify-between">
            <div>
              <span class="text-xs text-parchment-600 block mb-2">{art.date}</span>
              <h3 class="font-serif text-xl text-parchment-200 hover:text-amber-candle transition mb-3">
                {art.seznamUrl ? (
                  <a href={art.seznamUrl} target="_blank" rel="noopener" class="inline-flex items-baseline gap-1">
                    {art.title} <ExternalLink class="w-3 h-3 self-center text-parchment-600" />
                  </a>
                ) : (
                  <a href={`/clanky/${art.id}`}>{art.title}</a>
                )}
              </h3>
              <p class="text-parchment-400 text-sm font-light leading-relaxed line-clamp-3 mb-4">
                {art.perex}
              </p>
            </div>
            {art.seznamUrl ? (
              <a href={art.seznamUrl} target="_blank" rel="noopener" class="text-xs text-amber-candle uppercase tracking-wider font-semibold inline-flex items-center gap-1">
                Číst na Seznam Médium <ArrowRight class="w-3 h-3" />
              </a>
            ) : (
              <a href={`/clanky/${art.id}`} class="text-xs text-amber-candle uppercase tracking-wider font-semibold inline-flex items-center gap-1">
                Číst celou esej <ArrowRight class="w-3 h-3" />
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- MANIFEST / FILOZOFIE PROJEKTU -->
  <section class="py-24 max-w-4xl mx-auto px-6 text-center">
    <div class="w-12 h-12 rounded-full border border-amber-candle/30 bg-night-800 text-amber-candle flex items-center justify-center mx-auto mb-6">
      <BookOpen class="w-5 h-5" />
    </div>
    <h2 class="font-serif text-3xl sm:text-4xl text-parchment-200 mb-6">
      Proč se dívat do minulosti očima archiváře?
    </h2>
    <p class="text-parchment-400 font-light text-base sm:text-lg leading-relaxed mb-8">
      Dějiny nejsou sled bitev a panovnických rodokmenů. Skutečná historie se odehrávala v šeru vesnických světnic, v městských šatlavách a na polních cestách. Noční Knihovna nehodnotí moderní optikou. Pouze čistí prach ze zažloutlých listin a nechává promluvit ty, kteří už sami mluvit nemohou.
    </p>
    <a 
      href="/o-projektu" 
      class="inline-block text-xs uppercase tracking-widest px-6 py-3 rounded-md bg-night-800 border border-night-700 text-parchment-200 hover:border-amber-candle hover:text-amber-candle transition duration-300"
    >
      Poznejte zázemí badatelny
    </a>
  </section>
</Layout>
